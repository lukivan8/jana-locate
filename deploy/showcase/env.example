SHOWCASE_HOSTNAME=jana-locate.example.com
ALLOW_DEMO_CATALOG=false
# Owner of the private token file (id -u / id -g on the deployment host).
SHOWCASE_UID=1000
SHOWCASE_GID=1000
# Pin the connector version; upgrades are a separate deployment decision.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0
