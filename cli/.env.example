CLI_PORT=8095
CLI_BIND_ADDRESS=127.0.0.1
JANA_API_URL=http://host.docker.internal:8080
# Browser login: jana / this locally chosen password (at least 16 characters).
JANA_WEB_TOKEN=replace-with-your-local-password
# Resolve these only inside the CLI container / process.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# Alternatively set JANA_DATABASE_URL or mount JANA_DATABASE_URL_FILE.
# For a TLS gateway, set its exact browser origin:
# JANA_PUBLIC_ORIGIN=https://your-test-host.example

# URL opened by W on the operator machine (forwarded port or TLS gateway):
# JANA_BROWSER_URL=http://localhost:8095/

# Explicitly disable browser password only when intended (default: password).
# JANA_WEB_AUTH=none
