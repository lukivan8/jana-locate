# Dependency image must be prepared before building this offline candidate.
ARG CRF_IMAGE=jana-numeric-deps:0.9.12
FROM ${CRF_IMAGE} AS crf
FROM python:3.11-slim-bookworm
COPY --from=crf /usr/local/lib/python3.11/site-packages/pycrfsuite /usr/local/lib/python3.11/site-packages/pycrfsuite
COPY --from=crf /usr/local/lib/python3.11/site-packages/python_crfsuite-0.9.12.dist-info /usr/local/lib/python3.11/site-packages/python_crfsuite-0.9.12.dist-info
WORKDIR /app
COPY runtime/span-crf/model.py /app/span-crf/model.py
COPY runtime/integrated-candidate-v1/diagnostics.py /app/integrated-candidate-v1/diagnostics.py
COPY runtime/numeric-recovery/ /app/numeric-recovery/
COPY assets/numeric-recovery/model.crfsuite /app/model.crfsuite
ENV PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=2s CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/ready',timeout=1).read()"]
ENTRYPOINT ["python", "-u", "/app/numeric-recovery/server_numeric.py"]
