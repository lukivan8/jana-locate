{
  "openapi": "3.0.3",
  "info": {
    "title": "Jana Address API",
    "version": "0.1.0",
    "description": "Offline address parsing and building catalog geocoding. Demo catalog coordinates are synthetic. Unknown address fields are explicit null. See docs/consumer-guide.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/normalize": {
      "post": {
        "operationId": "normalize",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/NormalizeResponse"
                    },
                    {
                      "$ref": "#/components/schemas/NormalizeArrayResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 2 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/NormalizeRequest"
                  },
                  {
                    "$ref": "#/components/schemas/NormalizeArrayRequest"
                  }
                ]
              }
            }
          }
        },
        "description": "Accepts either {records: [...]} or a top-level array. Successful responses mirror the input shape: {results: [...]} for an object, an array for an array. Result fields and validation limits are identical. Errors always use the Error object."
      }
    },
    "/v1/catalog": {
      "get": {
        "operationId": "catalog",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/confirmations": {
      "post": {
        "operationId": "confirm",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogEntry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Storage or internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict; reload catalog before retrying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmationRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressFields": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "province",
          "city",
          "district",
          "living_area",
          "street_type",
          "street_name",
          "house",
          "apartment",
          "entrance",
          "floor",
          "landmark"
        ],
        "properties": {
          "province": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "living_area": {
            "type": "string",
            "nullable": true
          },
          "street_type": {
            "type": "string",
            "nullable": true
          },
          "street_name": {
            "type": "string",
            "nullable": true
          },
          "house": {
            "type": "string",
            "nullable": true
          },
          "apartment": {
            "type": "string",
            "nullable": true
          },
          "entrance": {
            "type": "string",
            "nullable": true
          },
          "floor": {
            "type": "string",
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InputRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "raw_address"
        ],
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "int64"
              }
            ],
            "x-go-type": "interface{}",
            "description": "String or int64 identifier. Use strings for integers outside JavaScript safe range. Never used for matching."
          },
          "raw_address": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "Coordinates": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "format": "double"
          }
        }
      },
      "CatalogEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "fields",
          "coordinates",
          "source",
          "confirmed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "$ref": "#/components/schemas/AddressFields"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "source": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      },
      "NormalizeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "records"
        ],
        "properties": {
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/InputRecord"
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "province",
          "city",
          "district",
          "living_area",
          "street_type",
          "street_name",
          "house",
          "apartment",
          "entrance",
          "floor",
          "landmark",
          "id",
          "raw_address",
          "confidence",
          "coordinates",
          "catalog_id",
          "catalog_revision",
          "status",
          "warnings"
        ],
        "properties": {
          "province": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "living_area": {
            "type": "string",
            "nullable": true
          },
          "street_type": {
            "type": "string",
            "nullable": true
          },
          "street_name": {
            "type": "string",
            "nullable": true
          },
          "house": {
            "type": "string",
            "nullable": true
          },
          "apartment": {
            "type": "string",
            "nullable": true
          },
          "entrance": {
            "type": "string",
            "nullable": true
          },
          "floor": {
            "type": "string",
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "int64"
              }
            ],
            "x-go-type": "interface{}",
            "description": "String or int64 identifier. Use strings for integers outside JavaScript safe range. Never used for matching."
          },
          "raw_address": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "format": "double"
          },
          "coordinates": {
            "$ref": "#/components/schemas/NullableCoordinates"
          },
          "catalog_id": {
            "type": "string",
            "nullable": true
          },
          "catalog_revision": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "needs_review",
              "unmatched"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "NormalizeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            }
          }
        }
      },
      "ConfirmationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fields",
          "coordinates",
          "expected_revision"
        ],
        "properties": {
          "fields": {
            "$ref": "#/components/schemas/AddressFields"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "NullableCoordinates": {
        "type": "object",
        "nullable": true,
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "format": "double"
          }
        }
      },
      "NormalizeArrayRequest": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "$ref": "#/components/schemas/InputRecord"
        }
      },
      "NormalizeArrayResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Result"
        }
      }
    }
  }
}
