  "components": {
    "schemas": {
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "province",
          "city",
          "district",
          "living_area",
          "street_type",
          "street_name",
          "house",
          "apartment",
          "entrance",
          "floor",
          "landmark",
          "id",
          "raw_address",
          "confidence",
          "coordinates",
          "catalog_id",
          "catalog_revision",
          "status",
          "warnings"
        ],
        "properties": {
          "province": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "living_area": {
            "type": "string",
            "nullable": true
          },
          "street_type": {
