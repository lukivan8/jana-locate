    "/v1/events": {
      "get": {
        "operationId": "watchWorkspace",
        "description": "SSE journal snapshots. Named runs events contain RunList JSON on connect and whenever persisted run state changes. Reconnect receives a fresh snapshot; comment heartbeats keep proxies alive.",
