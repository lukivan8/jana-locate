{
  "name": "jana-address-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "contract:generate": "openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts && openapi-typescript src/api/local-openapi.json -o src/api/local-schema.gen.ts",
    "contract:pull": "node scripts/pull-contract.mjs",
    "test:e2e": "playwright test",
    "theme:generate": "node scripts/generate-theme.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "openapi-fetch": "0.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
